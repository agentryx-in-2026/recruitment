{
  "name": "hirestream-lite",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:push:test": "NODE_ENV=test dotenv -- bash -c 'DATABASE_URL=${TEST_DATABASE_URL} drizzle-kit push'",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --forceExit",
    "test:integration": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --runInBand --forceExit",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --forceExit",
    "test:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --coverage",
    "test:e2e": "playwright test",
    "schema-fuzz": "node scripts/schema-fuzz.mjs",
    "smoke": "node scripts/deep-smoke.mjs",
    "smoke:local": "DEEP_URL=http://localhost:5001 node scripts/deep-smoke.mjs",
    "smoke:prod": "node tools/synthetic/run-prod-smoke.mjs",
    "test:deep": "npm test && npm run smoke",
    "verify:skeleton": "node scripts/verify-skeleton.mjs",
    "log:digest": "node tools/log-analyzer/digest.mjs",
    "log:triage": "node tools/triage/triage.mjs",
    "test:llm": "node tools/triage/triage.mjs --connectivity",
    "confidence": "node scripts/confidence.mjs",
    "release": "bash scripts/create-release.sh patch",
    "release:minor": "bash scripts/create-release.sh minor",
    "release:major": "bash scripts/create-release.sh major",
    "release:hotfix": "bash scripts/create-release.sh hotfix"
  },
